# ─── Copy these into Vercel → Project → Settings → Environment Variables ───
# Select "Production" for each one.

NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://aiworkss0211_db_user:<password>@onekindact.lkwoyko.mongodb.net/onekindact?retryWrites=true&w=majority

# JWT — generate a strong random string: openssl rand -base64 64
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=30d

# Your Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://onekindactt.vercel.app

# Cloudinary (optional — local disk fallback if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (optional — sandbox fallback if omitted)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Paystack (optional — sandbox fallback if omitted)
PAYSTACK_SECRET_KEY=sk_live_...

# Fortpesa (M-Pesa STK Push) — get these from your Fortpesa dashboard
FORTPESA_API_KEY=pb_live_...
FORTPESA_CHANNEL_ID=100
FORTPESA_WEBHOOK_SECRET=whsec_...

# PayPal (optional — unavailable if omitted)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_CURRENCY=USD
PAYPAL_BASE_URL=https://api-m.paypal.com
